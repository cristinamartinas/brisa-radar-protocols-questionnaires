# Keep the build context small and free of host-specific state. Everything the
# image needs is generated inside the build (deps, Prisma client, .next).
node_modules
.next
out
build

# Never bake local secrets or a host database into the image — DATABASE_URL is
# supplied at runtime by compose/the host environment.
.env
.env.*
!.env.example
dev.db
dev.db-journal
prisma/*.db
prisma/*.db-journal

# Generated Prisma client is regenerated in the builder stage.
src/generated

# Local tooling noise.
.git
.gitignore
*.tsbuildinfo
coverage
npm-debug.log*
.DS_Store
