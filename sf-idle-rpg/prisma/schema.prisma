// Shakes & Fidget–style idle RPG schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A player account. One account owns one hero (for now).
model Player {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  character Character?
}

/// The hero the player controls. All progression lives here.
/// IMPORTANT: every number in this model is written only by server-side
/// game logic — the browser never sets stats directly (anti-cheat).
model Character {
  id           String   @id @default(cuid())
  player       Player   @relation(fields: [playerId], references: [id])
  playerId     String   @unique

  name         String
  class        String   // WARRIOR | MAGE | SCOUT

  level        Int      @default(1)
  experience   Int      @default(0)
  gold         Int      @default(100)
  mushrooms    Int      @default(10) // premium currency, S&F flavour

  // Core attributes
  strength     Int      @default(10)
  dexterity    Int      @default(10)
  intelligence Int      @default(10)
  constitution Int      @default(10)
  luck         Int      @default(5)

  arenaWins    Int      @default(0)
  arenaLosses  Int      @default(0)

  guild        Guild?   @relation(fields: [guildId], references: [id], onDelete: SetNull)
  guildId      String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questLogs    QuestLog[]
  battleLogs   BattleLog[]
  items        Item[]
  activeQuest  ActiveQuest?
  dungeons     DungeonProgress[]
}

/// A player guild. Purely social for now: a shared roster, a leaderboard, and
/// a small gold perk for members. `founderId` is the character id of whoever
/// created it.
model Guild {
  id          String      @id @default(cuid())
  name        String      @unique
  tag         String
  description String      @default("")
  founderId   String
  createdAt   DateTime    @default(now())
  members     Character[]
}

/// How far a hero has descended into a given dungeon. `floor` is the next
/// floor to attempt; when it passes the dungeon's floor count the run is
/// cleared (`clearedAt` is stamped).
model DungeonProgress {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String
  dungeonKey  String
  floor       Int       @default(1)
  clearedAt   DateTime?

  @@unique([characterId, dungeonKey])
}

/// A quest currently in progress. A hero can have at most one at a time; the
/// reward is locked in at start and only paid out when `endsAt` has passed
/// (the ready-check is enforced server-side in the collect action).
model ActiveQuest {
  id             String    @id @default(cuid())
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId    String    @unique
  title          String
  goldReward     Int
  xpReward       Int
  mushroomReward Int       @default(0)
  durationSec    Int
  startedAt      DateTime  @default(now())
  endsAt         DateTime
}

/// A piece of equipment. Items live in one of three places (see `location`):
/// the character's personal Magic Shop, their inventory, or an equipment slot.
/// Bonuses are added on top of the hero's base attributes when equipped.
model Item {
  id           String    @id @default(cuid())
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId  String

  name         String
  slot         String    // WEAPON | ARMOR | AMULET
  rarity       String    // COMMON | RARE | EPIC | LEGENDARY
  location     String    @default("SHOP") // SHOP | INVENTORY | EQUIPPED

  strength     Int       @default(0)
  dexterity    Int       @default(0)
  intelligence Int       @default(0)
  constitution Int       @default(0)
  luck         Int       @default(0)
  price        Int

  createdAt    DateTime  @default(now())

  @@index([characterId, location])
}

/// History of completed quests (the idle "go adventure for a while" loop).
model QuestLog {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String
  title       String
  goldReward  Int
  xpReward    Int
  createdAt   DateTime  @default(now())
}

/// History of arena (PvP) fights, including a JSON blow-by-blow log.
model BattleLog {
  id           String    @id @default(cuid())
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId  String
  opponentName String
  won          Boolean
  goldChange   Int
  rounds       String    // JSON-encoded array of round descriptions
  createdAt    DateTime  @default(now())
}
