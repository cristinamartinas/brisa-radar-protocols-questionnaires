// Shakes & Fidget–style idle RPG schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A player account. One account owns one hero (for now).
model Player {
  id           String     @id @default(cuid())
  name         String     @unique
  passwordHash String?
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  character    Character?
}

/// The hero the player controls. All progression lives here.
/// IMPORTANT: every number in this model is written only by server-side
/// game logic — the browser never sets stats directly (anti-cheat).
model Character {
  id           String   @id @default(cuid())
  player       Player   @relation(fields: [playerId], references: [id])
  playerId     String   @unique

  name         String
  class        String   // WARRIOR | MAGE | SCOUT

  level        Int      @default(1)
  experience   Int      @default(0)
  gold         Int      @default(100)
  mushrooms    Int      @default(10) // premium currency, S&F flavour
  dust         Int      @default(0)  // crafting currency from salvaging gear

  skillLoadout String   @default("[]") // JSON: ordered [{skill,trigger}] rotation
  title        String?  // equipped cosmetic title key (must be unlocked)
  avatar       String?  // equipped avatar/portrait emoji key
  frameColor   String?  // equipped profile frame colour key
  banner       String?  // equipped profile banner key

  // Core attributes
  strength     Int      @default(10)
  dexterity    Int      @default(10)
  intelligence Int      @default(10)
  constitution Int      @default(10)
  luck         Int      @default(5)

  arenaWins    Int      @default(0)
  arenaLosses  Int      @default(0)
  arenaRating  Int      @default(1200) // Elo-style ranked-ladder rating

  guild        Guild?   @relation(fields: [guildId], references: [id], onDelete: SetNull)
  guildId      String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questLogs    QuestLog[]
  battleLogs   BattleLog[]
  items        Item[]
  activeQuest  ActiveQuest?
  dungeons     DungeonProgress[]
  ledger       CurrencyLedger[]
  talents      Talent[]
  achievements CharacterAchievement[]
  daily        DailyState?
  tower        TowerState?
  bossHits     WorldBossHit[]
  wheel        WheelState?
  pit          PitState?
  pets         Pet[]
  mail         Mail[]
  seasonPass   SeasonPassState?
  expedition   Expedition?
  fishing      FishingState?
  bounty       BountyState?
  dice         DiceState?
  dailyShop    DailyShopState?
}

// ---------------------------------------------------------------------------
// Wave 5 feature tables (economy + meta), built in parallel.
// ---------------------------------------------------------------------------

/// Per-hero bounty board state: which day's bounties are active and claimed.
/// Owned by the Bounty feature (src/lib/bounties.ts).
model BountyState {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String    @unique
  day         String    // UTC yyyy-mm-dd the current board is for
  claimed     String    @default("[]") // JSON array of claimed bounty keys
  updatedAt   DateTime  @updatedAt
}

/// Tavern dice gambling stats. Owned by the Dice feature (src/lib/dice.ts).
model DiceState {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String    @unique
  rolls       Int       @default(0)
  wins        Int       @default(0)
  biggestWin  Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

/// Per-hero daily-shop rotation marker. The offered items live in the Item
/// table with location "DAILY_SHOP". Owned by the Daily Shop feature.
model DailyShopState {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String    @unique
  day         String    // UTC yyyy-mm-dd the current stock is for
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Wave 4 feature tables (variety + liveops), built in parallel.
// ---------------------------------------------------------------------------

/// Progress in the current Seasonal Pass. Points are derived from activity;
/// this stores which tiers have been claimed. Owned by the Season Pass feature.
model SeasonPassState {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String    @unique
  season      String    @default("season-1")
  claimed     String    @default("[]") // JSON array of claimed tier indices
  updatedAt   DateTime  @updatedAt
}

/// A long, timed expedition (bigger + slower than a tavern quest). One at a
/// time; reward locked in at start, paid on collect. Owned by the Expeditions
/// feature (src/lib/expeditions.ts).
model Expedition {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String    @unique
  name        String
  tier        Int
  rewardGold  Int
  rewardXp    Int
  rewardDust  Int       @default(0)
  seed        String?
  startedAt   DateTime  @default(now())
  endsAt      DateTime
}

/// The Fishing Hole — cast on a cooldown for a seeded catch. Owned by the
/// Fishing feature (src/lib/fishing.ts).
model FishingState {
  id           String    @id @default(cuid())
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId  String    @unique
  lastCast     DateTime?
  totalCatches Int       @default(0)
  bestCatch    String?
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Wave 3 feature tables (idle + collection + live-ops), built in parallel.
// ---------------------------------------------------------------------------

/// Daily "Wheel of Fortune" spin state. Owned by the Wheel feature.
model WheelState {
  id           String    @id @default(cuid())
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId  String    @unique
  lastSpinDay  String?   // UTC yyyy-mm-dd of the last free spin
  spinsToday   Int       @default(0)
  totalSpins   Int       @default(0)
  updatedAt    DateTime  @updatedAt
}

/// The Pit — an idle gold generator that accrues over real time. Owned by the
/// Pit feature (src/lib/pit.ts).
model PitState {
  id            String    @id @default(cuid())
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId   String    @unique
  level         Int       @default(1)
  lastCollected DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// A collectable pet/companion. A hero may adopt several. Owned by the Pets
/// feature (src/lib/pets.ts).
model Pet {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String
  species     String    // pet species key, defined in code
  name        String
  level       Int       @default(1)
  xp          Int       @default(0)
  lastForaged DateTime?
  adoptedAt   DateTime  @default(now())

  @@index([characterId])
}

/// An inbox message, optionally carrying claimable rewards. Owned by the Mail
/// feature (src/lib/mail.ts). Other systems can enqueue mail via a helper.
model Mail {
  id             String    @id @default(cuid())
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId    String
  subject        String
  body           String    @default("")
  rewardGold     Int       @default(0)
  rewardMushrooms Int      @default(0)
  rewardDust     Int       @default(0)
  claimed        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([characterId, claimed])
}

// ---------------------------------------------------------------------------
// M2 feature tables (built in parallel — see docs/design). Each is owned by
// one feature module; the models live here so relations to Character resolve.
// ---------------------------------------------------------------------------

/// An allocated rank in the talent tree. Available points are DERIVED
/// (level - 1 - sum of ranks), so no separate points column is needed.
/// Owned by the Talents feature (src/lib/talents.ts).
model Talent {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String
  node        String    // talent node key, defined in code
  rank        Int       @default(0)

  @@unique([characterId, node])
}

/// A milestone a hero has unlocked. Achievement definitions live in code;
/// this only records what's been earned. Owned by the Achievements feature.
model CharacterAchievement {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String
  key         String    // achievement key, defined in code
  unlockedAt  DateTime  @default(now())

  @@unique([characterId, key])
}

/// Per-hero daily-tasks and login-streak state. Owned by the Dailies feature.
model DailyState {
  id            String    @id @default(cuid())
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId   String    @unique
  day           String    // UTC yyyy-mm-dd this state is for
  streak        Int       @default(0)
  lastClaimDay  String?   // UTC yyyy-mm-dd of the last streak claim
  tasksClaimed  String    @default("[]") // JSON array of claimed task keys for `day`
  loginClaimed  Boolean   @default(false)
  updatedAt     DateTime  @updatedAt
}

/// Append-only record of every currency movement. `Character.gold`/`mushrooms`
/// are cached balances; this ledger is the source of truth. Enables economy
/// auditing, anti-cheat anomaly detection, and dispute/refund handling — the
/// invariant is: sum(delta) for a currency == the cached balance, and the most
/// recent row's balanceAfter == the cached balance. Rows are never updated or
/// deleted (except by cascade when a hero is removed).
model CurrencyLedger {
  id           String    @id @default(cuid())
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId  String
  currency     String    // GOLD | MUSHROOMS
  delta        Int
  balanceAfter Int
  reason       String
  createdAt    DateTime  @default(now())

  @@index([characterId, createdAt])
}

/// A player guild. Purely social for now: a shared roster, a leaderboard, and
/// a small gold perk for members. `founderId` is the character id of whoever
/// created it.
model Guild {
  id          String      @id @default(cuid())
  name        String      @unique
  tag         String
  description String      @default("")
  founderId   String
  createdAt   DateTime    @default(now())
  members     Character[]
  rooms       GuildRoom[]
}

// ---------------------------------------------------------------------------
// Wave 2 feature tables (endgame + depth), built in parallel. Models live here
// so relations resolve; each is owned by one feature module.
// ---------------------------------------------------------------------------

/// Per-hero progress in the Infinite Tower (endless scaling floors).
/// Owned by the Tower feature (src/lib/tower.ts).
model TowerState {
  id           String    @id @default(cuid())
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId  String    @unique
  highestFloor Int       @default(0) // best floor ever cleared
  currentFloor Int       @default(1) // next floor to attempt this run
  runStartedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// A server-wide world boss everyone chips away at. Global rows (not per hero).
/// Owned by the World Boss feature (src/lib/worldboss.ts).
model WorldBoss {
  id          String         @id @default(cuid())
  name        String
  emoji       String         @default("👹")
  level       Int
  maxHp       Int
  hp          Int
  active      Boolean        @default(true)
  spawnedAt   DateTime       @default(now())
  defeatedAt  DateTime?
  hits        WorldBossHit[]

  @@index([active])
}

/// One hero's damage contribution to a world boss.
model WorldBossHit {
  id          String    @id @default(cuid())
  worldBoss   WorldBoss @relation(fields: [worldBossId], references: [id], onDelete: Cascade)
  worldBossId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String
  damage      Int
  createdAt   DateTime  @default(now())

  @@index([worldBossId, characterId])
}

/// An upgradable room in a guild hall, granting perks. Owned by the Guild Hall
/// feature (src/lib/guildhall.ts).
model GuildRoom {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String
  room    String // room key, defined in code
  level   Int    @default(1)

  @@unique([guildId, room])
}

/// How far a hero has descended into a given dungeon. `floor` is the next
/// floor to attempt; when it passes the dungeon's floor count the run is
/// cleared (`clearedAt` is stamped).
model DungeonProgress {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String
  dungeonKey  String
  floor       Int       @default(1)
  clearedAt   DateTime?

  @@unique([characterId, dungeonKey])
}

/// A quest currently in progress. A hero can have at most one at a time; the
/// reward is locked in at start and only paid out when `endsAt` has passed
/// (the ready-check is enforced server-side in the collect action).
model ActiveQuest {
  id             String    @id @default(cuid())
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId    String    @unique
  title          String
  goldReward     Int
  xpReward       Int
  mushroomReward Int       @default(0)
  durationSec    Int
  seed           String?   // RNG seed the reward roll came from (auditable)
  startedAt      DateTime  @default(now())
  endsAt         DateTime
}

/// A piece of equipment. Items live in one of three places (see `location`):
/// the character's personal Magic Shop, their inventory, or an equipment slot.
/// Bonuses are added on top of the hero's base attributes when equipped.
model Item {
  id           String    @id @default(cuid())
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId  String

  name         String
  slot         String    // WEAPON | ARMOR | AMULET
  rarity       String    // COMMON | RARE | EPIC | LEGENDARY
  location     String    @default("SHOP") // SHOP | INVENTORY | EQUIPPED

  strength     Int       @default(0)
  dexterity    Int       @default(0)
  intelligence Int       @default(0)
  constitution Int       @default(0)
  luck         Int       @default(0)
  price        Int

  createdAt    DateTime  @default(now())

  @@index([characterId, location])
}

/// History of completed quests (the idle "go adventure for a while" loop).
model QuestLog {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String
  title       String
  goldReward  Int
  xpReward    Int
  createdAt   DateTime  @default(now())
}

/// History of arena (PvP) fights, including a JSON blow-by-blow log.
model BattleLog {
  id           String    @id @default(cuid())
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId  String
  opponentName String
  won          Boolean
  goldChange   Int
  rounds       String    // JSON-encoded array of round descriptions
  seed         String?   // RNG seed the fight was resolved from (recomputable)
  createdAt    DateTime  @default(now())
}
